# Both forms. `node_modules/` matches a directory and NOT a symlink of that
# name, so a worktree that symlinks its dependencies at the real checkout got
# the LINK committed — a dangling absolute path in anybody else's clone.
node_modules
node_modules/
dist/
coverage/
*.tsbuildinfo
.DS_Store
*.log
.tmp/
# `rotorcc upgrade` stages a build here and parks the outgoing one here, so that
# a failed build can never touch the dist/ this machine is running from.
.rotorcc-upgrade/
.rotorcc-dist-previous/
*.tgz
